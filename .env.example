# =============================================================================
# BETPREDICT AI — Environment configuration
# Copy to .env and fill in real values. Never commit secrets.
# =============================================================================

# Application
APP_NAME=BETPREDICT AI
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
LEGAL_AGE_MINIMUM=18

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=betpredict
POSTGRES_PASSWORD=betpredict_secret
POSTGRES_DB=betpredict
DATABASE_URL=postgresql+asyncpg://betpredict:betpredict_secret@localhost:5432/betpredict
DATABASE_URL_SYNC=postgresql://betpredict:betpredict_secret@localhost:5432/betpredict

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Sports data providers (leave empty to use DEMO mode)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
SPORTMONKS_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
FOOTBALL_DATA_ORG_KEY=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4
PRIMARY_DATA_PROVIDER=demo

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mobile Money (optional — region dependent)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
WHATSAPP_BUSINESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=betpredict-football
